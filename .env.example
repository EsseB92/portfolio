# ─── Hostinger SMTP ────────────────────────────────────
# Trouve ces infos dans hPanel → Emails → Comptes email
# → clic sur "Configurer le client de messagerie"

SMTP_HOST=mail.erdus.fr
SMTP_PORT=465
SMTP_USER=contact@erdus.fr
SMTP_PASS=ton_mot_de_passe_email

# ─── Adresses ──────────────────────────────────────────
# MAIL_TO   = adresse qui reçoit les messages du formulaire
# MAIL_FROM = adresse expéditrice (doit = SMTP_USER chez Hostinger)

MAIL_TO=contact@erdus.fr
MAIL_FROM=contact@erdus.fr
